# Video Trend Intel — 환경 변수 예시
#
# 사용법: 이 파일을 .env로 복사해 필요한 값만 채운다 (.env는 git에 올라가지 않는다).
#   cp .env.example .env
# 수집기(npm run collect / export / collect-and-export)와 서버(npm start)가 저장소 루트의 .env를 읽는다.
# 이미 설정된 실제 환경 변수가 .env보다 우선한다. 값이 비어 있으면 설정하지 않은 것과 같다.
#
# GitHub Actions(3시간 주기 수집·배포)에서는 이 파일을 쓰지 않는다. 같은 이름을 저장소
# Settings > Secrets and variables > Actions 에 등록한다 (인증 정보는 Secrets, 조정값은 Variables).
# `bash deploy/bootstrap.sh --secrets` 가 이 파일의 인증 정보를 저장소 Secrets로 복사한다(값은 출력하지 않음).

# ─────────────────────────────────────────────────────────────────────────────
# 1) 인증이 필요한 원천 (없으면 해당 어댑터는 비활성, 나머지는 그대로 동작)
#    키 없이 항상 동작: YouTube RSS(시드 채널별 최신 15개), Dailymotion, PeerTube(SepiaSearch), niconico
# ─────────────────────────────────────────────────────────────────────────────

# YouTube Data API v3 — 키워드 검색(search.list), 조회·좋아요·댓글 수, 채널 구독자 수
# 발급: Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > API 키 (YouTube Data API v3 사용 설정)
# 기본 할당량 10,000 unit/일: search.list 1회 = 100 unit
YOUTUBE_API_KEY=
# 실행당 검색 횟수 (기본 8, 3시간 주기면 하루 64회 = 6,400 unit)
YOUTUBE_SEARCHES_PER_RUN=
# 검색 지역 (기본 KR)
YOUTUBE_REGION_CODE=

# TikTok Research API — 승인된 연구 목적 계정만 사용 가능 (client credentials)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# 조회 지역, 쉼표 구분 (기본 KR)
TIKTOK_REGION_CODES=
# 검색 기간 일수 (기본 7, 최대 30)
TIKTOK_LOOKBACK_DAYS=
# 실행당 키워드 질의 수 (기본 10) / 질의당 페이지 수 (기본 2)
TIKTOK_QUERIES_PER_RUN=
TIKTOK_PAGES_PER_QUERY=

# Instagram Graph API — 우리 IG 프로페셔널 계정의 토큰과 ID로 business_discovery·해시태그 검색
IG_ACCESS_TOKEN=
IG_USER_ID=
# 관찰할 비즈니스·크리에이터 계정 사용자 이름, 쉼표 구분 (예: natgeo,nasa)
IG_BUSINESS_USERNAMES=
# 해시태그 시드, 쉼표 구분 (계정당 7일에 고유 해시태그 30개 한도)
IG_HASHTAGS=
# 계정당 미디어 페이지 수 (기본 1, 최대 20) / Graph API 버전 (기본값은 수집기 코드에 고정)
IG_MEDIA_PAGES=
IG_GRAPH_API_VERSION=

# X API v2 — 최근 검색(has:videos). 게시물 읽기량 기준 과금될 수 있다.
# 조회수는 X의 노출(impressions) 기준이라 영상 재생 수와 단위가 다르다.
X_BEARER_TOKEN=
# 실행당 질의 수 (기본 5) / 질의당 페이지 (기본 1) / 페이지당 결과 (기본 100, 10~100)
X_QUERIES_PER_RUN=
X_PAGES_PER_QUERY=
X_MAX_RESULTS=
# relevancy(기본) 또는 recency / 필드 매개변수 이름 호환 설정 (post.fields 기본, 구버전은 tweet.fields)
X_SORT_ORDER=
X_FIELDS_PARAM=

# Twitch Helix — 인기 게임별 클립·다시보기 (app access token)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# 선택: 사용자 액세스 토큰이 있으면 팔로워 수 조회 (없으면 팔로워는 null)
TWITCH_USER_TOKEN=
# 언어 (기본 ko) / 상위 게임 수 (기본 5) / 클립 페이지 (기본 1) / 클립 기간 일수 (기본 7) / 팔로워 조회 상한 (기본 50)
TWITCH_LANGUAGE=
TWITCH_TOP_GAMES=
TWITCH_CLIP_PAGES=
TWITCH_CLIP_DAYS=
TWITCH_MAX_FOLLOWER_LOOKUPS=

# ─────────────────────────────────────────────────────────────────────────────
# 2) 서버 (npm start = apps/server: REST API + 웹 + 주기 수집)
# ─────────────────────────────────────────────────────────────────────────────

# 포트 (기본 8787) / 바인드 주소 (기본 0.0.0.0)
PORT=8787
HOST=
# 데이터 폴더 (기본 <저장소>/data): store.sqlite, export/dataset.json, logs/ 가 들어간다.
# 서버 전용 설정이다. 수집기 CLI는 항상 <저장소>/data 를 쓴다 (다른 위치는 --db / --out 옵션).
DATA_DIR=
# 개별 경로 재지정 (기본: DATA_DIR/export, DATA_DIR/store.sqlite, apps/web/dist)
EXPORT_DIR=
DB_PATH=
WEB_DIST_DIR=
# 내보내기 파일이 없을 때 대신 읽을 dataset.json 경로 (선택)
DATASET_PATH=

# 서버 내장 수집 주기(분). 기본 180 = 3시간, 0이면 서버는 수집하지 않고 새 내보내기 파일만 다시 읽는다.
# (Windows 예약 작업이나 GitHub Actions로 수집한다면 0)
COLLECT_INTERVAL_MIN=180
# 서버 시작 후 첫 수집까지 최소 대기(초, 기본 60) / 1이면 시작하자마자 수집
COLLECT_START_DELAY_SEC=
COLLECT_ON_START=
# 수집할 어댑터 id, 쉼표 구분 (기본: 활성화된 전체)
# youtube-rss, dailymotion, peertube, niconico, youtube-data-api, tiktok-research, instagram-graph, x-api, twitch
COLLECT_SOURCES=
# 원천별 실행당 요청 상한 재지정 (기본: 어댑터별 기본값)
COLLECT_MAX_REQUESTS=
# dataset.json 크기 예산 MB (기본 40; 넘으면 조회수 낮은 오래된 영상부터 빼고 exportNotes에 기록)
EXPORT_BUDGET_MB=
# 1이면 서버가 수집할 때마다 apps/web/public/data/dataset.json 에도 복사 (npm run dev 용)
EXPORT_COPY_TO_WEB=
# 내보내기 파일 변경 확인 주기(초, 기본 30)
WATCH_POLL_SEC=

# 클라이언트별 분당 요청 한도 (기본 120, 0이면 끔) / 1이면 X-Forwarded-For 신뢰 (리버스 프록시 뒤에서만)
RATE_LIMIT_PER_MIN=
TRUST_PROXY=

# ─────────────────────────────────────────────────────────────────────────────
# 3) Docker Compose (docker-compose.yml)
# ─────────────────────────────────────────────────────────────────────────────

# 호스트에 노출할 포트 (컨테이너 안은 항상 8787)
VTI_PORT=8787
